{
  "name": "us-staaten",
  "version": "1.0.0",
  "private": true,
  "description": "PWA zum spielerischen Lernen der US-Bundesstaaten",
  "type": "module",
  "scripts": {
    "build:map": "node tools/build-map.mjs",
    "build:icons": "python3 tools/build-icons.py",
    "test": "node --test tests/*.test.js",
    "start": "npx --yes http-server@14.1.1 app -p 8080 -c-1",
    "build:europe": "node tools/build-europe-map.mjs"
  },
  "devDependencies": {
    "d3-geo": "3.1.1",
    "flag-icons": "^7.5.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1",
    "world-atlas": "^2.0.2"
  }
}
